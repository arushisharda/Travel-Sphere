NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL="file:./dev.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://user:pass@host:5432/travelsphere"

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=3500

OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v1
EXTERNAL_TIMEOUT_MS=8000
