# ── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Database (SQLite for simple deploy, use file path)
DATABASE_URL=file:./prisma/prod.db

# JWT — generate a strong random secret (min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS

# NVIDIA API for itinerary generation
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Optional (defaults shown) ──────────────────────────────────────────────────
# CLIENT_ORIGIN=https://your-deployed-domain.railway.app
# BCRYPT_COST=12
# AI_TIMEOUT_MS=45000
# AI_MAX_OUTPUT_TOKENS=3500
